# Supabase — Transaction pooler (for app runtime, works with serverless)
# Format: postgresql://postgres.[project-ref]:[YOUR-DB-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — Direct connection (for Prisma migrations only)
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.hwipzqtcyslkyfmlxcrs.supabase.co:5432/postgres"




